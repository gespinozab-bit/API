# Valores de ejemplo: reemplazar la contraseña solo en .env (ignorado por Git).
# Mantener las credenciales y el puerto de DATABASE_URL sincronizados.
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=inventory_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://inventory_user:change_this_local_password@localhost:5433/inventory_db?schema=public
PORT=3000
